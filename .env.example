# Copy to .env for local runs. All values optional; defaults shown.
SOCIAL_MATCH_DB=./social_match.db
STATE_TTL_DAYS=7            # availability expires this many days after observation
SIMILARITY_FLOOR=0          # 0 = time alone can make a card; 0.5 = students must share at least a domain
CODE_TTL_SECONDS=300        # pairing code lifetime
POLL_SWEEP_SECONDS=3600     # background sweep interval
BASE_URL=http://localhost:8000   # external base for links in texts
SESSION_SECRET=change-me
BLOCK_SALT=change-me
REGISTRATION_CODE=cubbie2026   # invite-only gate for signup

# --- Chat app (optional; unset AI_API_URL = chat disabled, 503 on the chat POST) ---
# AI_API_URL=https://api.nano-gpt.com/v1/chat/completions   # full POST URL, OpenAI chat-completions ONLY
AI_API_KEY=
AI_MODEL=z-ai/glm-5.3
AI_MAX_TOKENS=800
AI_TIMEOUT_SECONDS=60
AI_TTL_DAYS=7
# Demo-box only: seeds the delegation grant at signup so assistants negotiate hands-free.
# Absent = off; only Settings can change the grant afterwards (chat never can).
DELEGATION_DEFAULT_ON=1

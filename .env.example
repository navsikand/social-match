STATE_TTL_DAYS=7            # availability expires this many days after observation
CODE_TTL_SECONDS=300        # pairing code lifetime
POLL_SWEEP_SECONDS=3600     # background sweep interval
BASE_URL=http://localhost:8000   # external base for links in texts
SESSION_SECRET=change-me
BLOCK_SALT=change-me
REGISTRATION_CODE=cubbie2026   # invite-only gate for signup
